# Copy to application-local.properties (gitignored) and fill values.

# JWT_SECRET=generate-a-long-random-string

# Google OAuth
# spring.security.oauth2.client.registration.google.client-id=
# spring.security.oauth2.client.registration.google.client-secret=

# Cloudinary
# app.cloudinary.cloud-name=
# app.cloudinary.api-key=
# app.cloudinary.api-secret=

# Gmail SMTP app password for OTP / verification mail
# EMAIL_USERNAME=ac9949044@gmail.com
# EMAIL_PASSWORD=

# Public contact form inbox (defaults to EMAIL_USERNAME)
# CONTACT_INBOX=hello@rentanything.np

# eSewa sandbox uses public EPAYTEST credentials by default (no real money).
# Optional override: ESEWA_SECRET= (do not commit live merchant secrets)

# Khalti sandbox: create a free test merchant at https://test-admin.khalti.com
# and paste live_secret_key here. Test logins: 9800000000, MPIN 1111, OTP 987654.
# KHALTI_SECRET=
